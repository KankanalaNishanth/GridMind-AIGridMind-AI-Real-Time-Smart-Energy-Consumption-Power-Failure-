# Copy this file to .env and fill in your real values.
# .env is git-ignored — never commit real credentials.

# --- App ---
APP_NAME=GridMind AI
APP_VERSION=1.0.0
ENVIRONMENT=development
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Paths ---
DATA_DIR=data
MODELS_DIR=models
REPORTS_DIR=reports

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=gridmind_ai

# --- ML pipeline params ---
ISO_FOREST_CONTAMINATION=0.05
DISRUPTION_BILLING_RATIO_THRESHOLD=0.7
DISRUPTION_RISK_ALERT_THRESHOLD=0.7
ANOMALY_SCORE_ALERT_THRESHOLD=-0.1
KMEANS_N_CLUSTERS=4
SARIMA_FORECAST_STEPS=6
